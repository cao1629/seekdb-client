{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 19, "patch": 0 },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Native (host platform)",
            "binaryDir": "${sourceDir}/build"
        },
        {
            "name": "android",
            "displayName": "Android arm64-v8a (NDK)",
            "binaryDir": "${sourceDir}/build-android",
            "toolchainFile": "${sourceDir}/cmake/android-arm64-toolchain.cmake",
            "cacheVariables": {
                "OPENSSL_ROOT_DIR": "${sourceDir}/build/openssl-android-build/install"
            }
        },
        {
            "name": "windows",
            "displayName": "Windows x86_64 (MinGW-w64)",
            "binaryDir": "${sourceDir}/build-win",
            "toolchainFile": "${sourceDir}/cmake/mingw-w64-x86_64-toolchain.cmake"
        }
    ],
    "buildPresets": [
        { "name": "default", "configurePreset": "default" },
        { "name": "android", "configurePreset": "android" },
        { "name": "windows", "configurePreset": "windows" }
    ]
}
